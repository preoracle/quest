# ── Quest API — Python/FastAPI backend ──────────────────────────────────────
FROM python:3.12-slim AS base

WORKDIR /app

# Install uv (fast Python package manager)
RUN pip install uv --no-cache-dir

# ── Dependency layer (cached unless pyproject.toml / uv.lock change) ─────────
COPY pyproject.toml uv.lock ./
# api extra: fastapi + uvicorn   postgres extra: psycopg[binary] + langgraph checkpoint + PyJWT
RUN uv sync --frozen --extra api --extra postgres --no-dev

# ── Application code ──────────────────────────────────────────────────────────
COPY . .

EXPOSE 8000

# uv run ensures the virtualenv is activated
CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
