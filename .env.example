# Anthropic API key. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Tutor model. claude-sonnet-4-6 is the stable Sonnet snapshot as of 2026.
# Override here if a newer Sonnet ships.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Evaluator model (Haiku). Cheap structured scoring per turn.
ANTHROPIC_EVAL_MODEL=claude-haiku-4-5

# PyPI upload (maintainers only). Used by scripts/publish_pypi.sh — never commit a real token.
# PYPI_TOKEN=pypi-...

# Supabase — get from your project dashboard > Settings > API & Database.
# Frontend (VITE_) vars are baked at build time; backend uses bare vars at runtime.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Backend uses SUPABASE_URL for JWT/JWKS verification (Settings > API > URL)
SUPABASE_URL=https://xxxx.supabase.co
# Use the TRANSACTION POOLER URL (port 6543) — required for psycopg3 + PgBouncer.
# Dashboard > Settings > Database > Connection pooling > Transaction mode > URI
DATABASE_URL=postgresql://postgres.xxxx:[password]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Backend: comma-separated list of allowed CORS origins (production frontend URL).
# Defaults to localhost:5173/5174 if unset (dev only).
# CORS_ORIGINS=https://your-app.vercel.app

# Backend: override the data directory for DB, checkpoints, and user topics.
# Useful on hosted environments with a persistent volume.
# QUEST_DATA_DIR=/data/quest

# Frontend: API base URL. Set to your backend's public URL for production builds.
# Falls back to /api (proxied by Vite dev server) if unset.
# VITE_API_URL=https://your-api.onrender.com
