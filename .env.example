# ─── LLM Backend (freellmapi — OpenAI-compatible proxy) ─────────────────────
# freellmapi aggregates Groq, Cerebras, Gemini, SambaNova, Mistral, etc.
# Run locally: cd freellmapi && npm start   (default: http://localhost:3001)
# In production: set LLM_BASE_URL to your Render private service internal URL.
LLM_BASE_URL=http://localhost:3001/v1

# freellmapi auth token — create one in the freellmapi admin dashboard.
# Locally you can use the default dev token. In production use a real token.
LLM_API_KEY=freellmapi-dev

# Model routing — all chains use LLM_BASE_URL + LLM_API_KEY (see core/llm_client.py).
# "auto" lets freellmapi pick the best provider. Each chain falls back to the next env var if unset.
LLM_MODEL=auto               # Tutor: LLM_MODEL → LLM_EVAL_MODEL (~200 tokens)
LLM_EVAL_MODEL=auto          # Eval + fallbacks: LLM_EVAL_MODEL → LLM_MODEL (~400 tokens)
LLM_SUMMARIZER_MODEL=auto    # Summary: LLM_SUMMARIZER_MODEL → LLM_EVAL_MODEL → LLM_MODEL (~256 tokens)
LLM_TOPIC_MODEL=auto         # Topic gen: LLM_TOPIC_MODEL → LLM_EVAL_MODEL → LLM_MODEL (~2k tokens)

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings > API
# VITE_ vars are baked into the frontend JS bundle at build time.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Backend uses SUPABASE_URL for JWT/JWKS verification only (no DB connection).
SUPABASE_URL=https://xxxx.supabase.co

# Google sign-in (Supabase Dashboard → Authentication → Providers → Google):
# 1. Create a Google Cloud OAuth client (Web application).
# 2. Authorized redirect URI: https://xxxx.supabase.co/auth/v1/callback
# 3. Paste Client ID + Secret into the Supabase Google provider.
# 4. Add redirect URLs in Supabase Auth → URL Configuration:
#    http://localhost:5173/auth/callback
#    https://your-app.vercel.app/auth/callback

# PostgreSQL connection string — use the TRANSACTION POOLER (port 6543).
# Supabase dashboard > Settings > Database > Connection pooling > Transaction mode > URI
DATABASE_URL=postgresql://postgres.xxxx:[password]@aws-0-REGION.pooler.supabase.com:6543/postgres

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Required when frontend and API are on different hosts (Vercel + Render).
# CORS_ORIGINS=https://quest-ai.vercel.app,https://quest.yourdomain.com
# Optional regex to match Vercel preview URLs:
# CORS_ORIGIN_REGEX=https://quest-.*\.vercel\.app

# ─── Frontend ────────────────────────────────────────────────────────────────
# URL of the backend API. Falls back to /api (proxied by Vite dev server) if unset.
# VITE_API_URL=https://quest-api.onrender.com

# ─── Data directory (hosted deployments) ─────────────────────────────────────
# Override where Quest stores YAML topics and SQLite checkpoints.
# On Render, mount a disk at /data and set this so data persists across deploys.
# QUEST_DATA_DIR=/data/quest

# ─── PyPI (maintainers only) ─────────────────────────────────────────────────
# PYPI_TOKEN=pypi-...
